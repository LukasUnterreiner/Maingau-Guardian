# Lighty backend configuration. Copy to .env and adjust. Never commit .env.

# --- Data -------------------------------------------------------------------
# In Docker the data folder is mounted at /srv/data (see compose.yaml).
DATA_DIR=./data
WORKBOOK_FILE=maingau_nba_mockdata.xlsx
EVENT_STREAM_FILE=event_stream_2026-10-01.jsonl
SNAPSHOT_AT=2026-09-30 23:59:59
# latest = replay the full event stream, snapshot = ignore events, or an ISO timestamp
EVALUATION_AS_OF=latest

# --- Persistence (SQLite decision log, approvals, settings, conversations) ---
# Default file lighty.sqlite3; set SQLITE_FILE=guardian.sqlite3 to keep the pre-rename file.
RUNTIME_DIR=./runtime

# --- API ----------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# If set, PUT /api/marketing/settings and approve/reject require header X-Admin-Token
ADMIN_TOKEN=
LOG_LEVEL=INFO

# --- Optional AI integration ---------------------------------------------------
# hessian.AI Inference API (Futury Build Days handout "Connect & query"): OpenAI-compatible
# /chat/completions, API key as Bearer token, one key per team. Models: vllm/Kolibri-1 (text,
# German-optimised, recommended) or vllm/GLM-Flash:Latest. Access ends 28.10.2026 09:00 (UTC+1).
# Put the team key only into .env on the server. With AI_API_KEY empty Lighty answers deterministically.
AI_API_KEY=
AI_BASE_URL=https://hip-gw.hessian.ai/v1
AI_MODEL=vllm/Kolibri-1
AI_PROTOCOL=openai_chat_completions
AI_TIMEOUT_S=20
# Request format details (match the hessian.AI gateway); adjust only for another provider after checking its docs.
AI_CHAT_PATH=/chat/completions
AI_AUTH_HEADER=Authorization
AI_AUTH_SCHEME=Bearer
AI_MAX_TOKENS=700

# --- Employee copilot (Lighty) --------------------------------------------------
# token:employee_id:role,...  roles: service_agent | sales_agent | marketing | admin
# Tokens must be at least 12 characters. Generate them, e.g. `openssl rand -hex 16`.
EMPLOYEE_TOKENS=
# Local development only: without tokens, accept X-Employee-Id / X-Employee-Role headers.
ALLOW_DEV_AUTH=false
# Also require an employee on the customer, marketing-list and AI endpoints.
PROTECT_CUSTOMER_ENDPOINTS=false
# Earlier messages of a conversation that are sent to the AI model, and turns per conversation.
COPILOT_HISTORY_MESSAGES=6
COPILOT_MAX_TURNS=40
# Pre-compute all decisions at startup.
WARM_PORTFOLIO_ON_STARTUP=true
